{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://makerchecker.dev/schema/mc-policy.schema.json",
  "title": "mc-policy.json",
  "description": "The MakerChecker policy file. The free `mc scan` generates it (deny-by-default); the paid MakerChecker engine enforces this exact file in production. It is both the scan configuration and the governance policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Schema version.",
      "enum": [1]
    },
    "severityThreshold": {
      "type": "string",
      "description": "Minimum severity shown in the scan inventory.",
      "enum": ["CATASTROPHIC", "HIGH", "MEDIUM", "OK"],
      "default": "MEDIUM"
    },
    "failOn": {
      "type": "string",
      "description": "Severity at or above which the CLI exits non-zero (for CI gating). Governed and OK tools are excluded.",
      "enum": ["CATASTROPHIC", "HIGH", "MEDIUM", "OK"],
      "default": "CATASTROPHIC"
    },
    "ignore": {
      "type": "array",
      "description": "Tool names to skip entirely (never flagged, not counted).",
      "items": { "type": "string" },
      "default": []
    },
    "allow": {
      "type": "object",
      "description": "Tools that are already governed. Each entry names the gate that governs the tool; the scan downgrades these to OK and marks them governed. The MakerChecker engine enforces the named gate before the tool runs.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "note"],
        "properties": {
          "gate": {
            "type": "string",
            "description": "The MakerChecker enforcement primitive that governs this tool.",
            "enum": [
              "high_risk_requires_gate",
              "approval_gate",
              "limit_violation",
              "skill_not_granted",
              "sod_violation",
              "independent_citation_verification"
            ]
          },
          "note": {
            "type": "string",
            "description": "Human-readable justification, typically naming the incident (aid) this tool resembles and the deny-by-default posture."
          }
        }
      },
      "default": {}
    },
    "customSignatures": {
      "type": "array",
      "description": "Organization-specific risk signatures merged over the built-in table. A custom signature whose id matches a built-in replaces it.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "verbs", "severity", "action", "resembles", "control", "why"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "verbs": { "type": "array", "items": { "type": "string" } },
          "argHints": { "type": "array", "items": { "type": "string" } },
          "strongVerbs": { "type": "array", "items": { "type": "string" } },
          "nameOnlyVerbs": { "type": "array", "items": { "type": "string" }, "description": "Verbs matched only as a whole token in the tool NAME, never in description/params prose." },
          "severity": { "type": "string", "enum": ["CATASTROPHIC", "HIGH", "MEDIUM"] },
          "action": { "type": "string" },
          "resembles": {
            "type": "object",
            "required": ["aid", "title"],
            "properties": {
              "aid": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "alsoResembles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["aid", "title"],
              "properties": {
                "aid": { "type": "string" },
                "title": { "type": "string" }
              }
            }
          },
          "control": {
            "type": "string",
            "enum": [
              "high_risk_requires_gate",
              "approval_gate",
              "limit_violation",
              "skill_not_granted",
              "sod_violation",
              "independent_citation_verification"
            ]
          },
          "why": { "type": "string" }
        }
      },
      "default": []
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional defaults for the opt-in --llm deep scan. Never put an API key here — keys come only from an environment variable or --llm-key, so this file stays committable.",
      "properties": {
        "mode": { "type": "string", "enum": ["tools", "code", "both"], "default": "both" },
        "provider": {
          "type": "string",
          "enum": ["anthropic", "openai", "openrouter", "together", "groq", "ollama", "openai-compatible"]
        },
        "model": { "type": "string" },
        "baseUrl": { "type": "string" },
        "jsonMode": { "type": "boolean" },
        "gateCi": { "type": "boolean", "description": "Let VERIFIED code-scan findings affect the CI exit code. Default false (LLM output is non-reproducible)." },
        "codeScan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxFiles": { "type": "integer" },
            "windowLines": { "type": "integer" },
            "maxBytesPerChunk": { "type": "integer" },
            "maxChunks": { "type": "integer" },
            "maxFindings": { "type": "integer" }
          }
        }
      }
    }
  }
}

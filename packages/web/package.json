{
  "name": "@makerchecker/web",
  "version": "1.0.0",
  "description": "MakerChecker web console: Vite/React SPA for roles, grants, approvals, runs, and audit verification.",
  "license": "AGPL-3.0-only",
  "author": "Mashini Investments Ltd. <hello@makerchecker.ai>",
  "homepage": "https://makerchecker.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makerchecker/MakerChecker.git",
    "directory": "packages/web"
  },
  "bugs": "https://github.com/makerchecker/MakerChecker/issues",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "dev": "vite"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.4",
    "happy-dom": "^20.14.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.2.7"
  }
}
